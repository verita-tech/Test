# {{ ansible_managed }}
# K3s schreibt /etc/rancher/k3s/k3s.yaml bei jedem Start neu (root:root).
# Dieser Hook stellt danach die Gruppenrechte wieder her, damit Mitglieder
# von "{{ k3s_server_kubeconfig_group }}" kubectl ohne sudo nutzen können.
[Service]
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do [ -f /etc/rancher/k3s/k3s.yaml ] && break; sleep 1; done; \
  if [ -f /etc/rancher/k3s/k3s.yaml ]; then \
    chgrp {{ k3s_server_kubeconfig_group }} /etc/rancher/k3s/k3s.yaml; \
    chmod {{ k3s_server_kubeconfig_mode }} /etc/rancher/k3s/k3s.yaml; \
  fi'
